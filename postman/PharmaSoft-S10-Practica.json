    {
      "name": "07 - Decodificar payload del token del vendedor",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const t = pm.collectionVariables.get('tokenVendedor');",
              "const p = JSON.parse(Buffer.from(t.split('.')[1], 'base64').toString());",
              "p['exp - iat'] = p.exp - p.iat;",
              "pm.visualizer.set('<h3>Payload del JWT (vendedor)</h3><pre style=\"font-size:14px\">{{json}}</pre>', { json: JSON.stringify(p, null, 2) });"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenVendedor}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        }
